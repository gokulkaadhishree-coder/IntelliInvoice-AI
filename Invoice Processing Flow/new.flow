          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.24.9\",\"scriptRef\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-google-gmail\",\"objectName\":\"EmailReply\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"EmailReply\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/EmailReply\",\"unifiedTypesCompatible\":true,\"savedInputMode\":\"fields\",\"savedJitInputFieldId\":\"in_EmailReply\"},\"optionalConfiguration\":{\"_textBlocks\":[],\"objectActions\":[],\"connectorName\":\"Gmail\",\"agentIdentity\":null,\"maxPageSize\":500,\"jobArguments\":null,\"isAutopilotInvalidConfig\":false,\"additionalHeaders\":null,\"cachedLookupValues\":[],\"cachedBrowserItems\":[],\"cachedPropertyMappings\":[],\"primaryKeys\":[\"id\"],\"objectDisplayName\":\"Email Reply\",\"eventMode\":null,\"eventOperation\":null,\"hasBreakingChanges\":false,\"fieldsContainer\":{\"outputTypeDefinition\":\"{\\\"id\\\":string;\\\"labelIds\\\":string[];\\\"threadId\\\":string}\",\"outputJsonSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"threadId\":{\"title\":\"Email thread identifier\",\"type\":\"string\",\"description\":\"Unique identifier for the email conversation thread.\"},\"labelIds[*]\":{\"title\":\"Label identifiers\",\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"Unique identifiers for the labels associated with the email.\"},\"id\":{\"title\":\"Email identifier\",\"type\":\"string\",\"description\":\"A unique identifier for the email message.\"}},\"definitions\":{}},\"hasFileOutput\":false,\"populateOutputFields\":true,\"inputFields\":[{\"typeScriptDefinition\":null,\"useUrlInput\":false,\"resolvedUrl\":null,\"id\":\"id\",\"name\":\"id\",\"displayName\":\"The email to reply to\",\"description\":\"T