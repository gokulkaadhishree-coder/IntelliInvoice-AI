      "form": {
        "id": "activity-properties",
        "title": "Agent",
        "sections": [
          {
            "id": "inputs",
            "title": "Inputs",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.invoiceData",
                "type": "text",
