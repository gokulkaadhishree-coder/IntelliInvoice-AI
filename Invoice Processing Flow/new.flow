    {
      "id": "script1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Transform Script",
        "subLabel": "",
        "color": "#FFB40E",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "// Parse the JSON string\r\nconst invoice = JSON.parse($vars.dataextraction1.output.invoiceData);\r\n\r\n// Helper: safely read a field\r\nconst readField = (fieldName) => invoice?.[fieldName] ?? null;\r\n\r\n// Helper: replace spaces with underscores\r\nconst sanitizeFieldName = (fieldName) =>\r\n  fieldName?.replace(/\\s+/g, \"_\") || \"\";\r\n\r\n// Build the result object\r\nconst result = {\r\n  invoice: {},\r\n  vendor: {},\r\n  lineItems: []\r\n};\r\n\r\n// --------------------\r\n// Invoice fields\r\n// --------------------\r\nconst invoiceFields = [\r\n  \"invoice_number\",\r\n  \"issue_date\",\r\n  \"due_date\",\r\n  \"po_reference\",\r\n  \"currency\",\r\n  \"subtotal\",\r\n  \"tax\",\r\n  \"total\"\r\n];\r\n\r\nfor (const field of invoiceFields) {\r\n  result.invoice[sanitizeFieldName(field)] = readField(field);\r\n}\r\n\r\n// --------------------\r\n// Vendor fields\r\n// --------------------\r\nconst vendorFields = [\r\n  \"vendor_name\",\r\n  \"vendor_address\",\r\n  \"remit_to_address\",\r\n  \"contact_email\"\r\n];\r\n\r\nfor (const field of vendorFields) {\r\n  result.vendor[sanitizeFieldName(field)] = readField(field);\r\n}\r\n\r\n// --------------------\r\n// Line Items\r\n// --------------------\r\nconst lineItems = readField(\"line_items\") || [];\r\n\r\nfor (const row of lineItems) {\r\n  const item = {};\r\n\r\n  for (const [key, value] of Object.entries(row)) {\r\n    item[sanitizeFieldName(key)] = value;\r\n  }\r\n\r\n  result.lineItems.push(item);\r\n}\r\n\r\nreturn result;",
          "fieldType": "string"
        },
        "errorHandlingEnabled": false
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "a1eef2da-8040-4471-96e7-f45ee856ff91"
    },
