    <bpmn:scriptTask id="script1" name="Transform Script" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:context>
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"vars":{"type":"object"},"metadata":{"type":"object"}},"required":[]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vars":"=vars","metadata":"=metadata"}]]></uipath:input>
          <uipath:output name="script1.output" type="object" source="=result.response" var="script1.output" />
          <uipath:output name="script1.error" type="object" source="=Error" var="script1.error" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>edge_dataextraction1-output-core.action.script-1785085293679-input</bpmn:incoming>
      <bpmn:outgoing>edge_core.action.script-1785085293679-success-contextGroundingSearch1-input</bpmn:outgoing>
      <bpmn:script><![CDATA[// Parse the JSON string
const invoice = JSON.parse(vars.dataextraction1.output.invoiceData);

// Helper: safely read a field
const readField = (fieldName) => invoice?.[fieldName] ?? null;

// Helper: replace spaces with underscores
const sanitizeFieldName = (fieldName) =>
  fieldName?.replace(/\s+/g, "_") || "";

// Build the result object
const result = {
  invoice: {},
  vendor: {},
  lineItems: []
};

// --------------------
// Invoice fields
// --------------------
const invoiceFields = [
  "invoice_number",
  "issue_date",
  "due_date",
  "po_reference",
  "currency",
  "subtotal",
  "tax",
  "total"
];

for (const field of invoiceFields) {
  result.invoice[sanitizeFieldName(field)] = readField(field);
}

// --------------------
// Vendor fields
// --------------------
const vendorFields = [
  "vendor_name",
  "vendor_address",
  "remit_to_address",
  "contact_email"
];

for (const field of vendorFields) {
  result.vendor[sanitizeFieldName(field)] = readField(field);
}

// --------------------
// Line Items
// --------------------
const lineItems = readField("line_items") || [];

for (const row of lineItems) {
  const item = {};

  for (const [key, value] of Object.entries(row)) {
    item[sanitizeFieldName(key)] = value;
  }

  result.lineItems.push(item);
}

return result;]]></bpmn:script>
    </bpmn:scriptTask>
